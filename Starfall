    for dx in offsets:
        enemy_rockets.append({
            "pos": e["pos"] + V(dx, 35),
            "dir": V(dx / 160, 1).normalize(),
            "speed": 190 if e["kind"] == "giant" else 175,
            "start": now
        })
    sound("rocket")



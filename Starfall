def effects_update(dt, now):
    for p in particles[:]:
        p["pos"] += p["vel"] * dt
        p["vel"] *= max(0, 1 - dt * 1.9)
        p["life"] -= dt
        if p["life"] <= 0:
            particles.remove(p)
            continue
        pygame.draw.circle(
            screen, p["color"], ip(p["pos"]),
            max(1, int(p["size"] * min(1, p["life"] * 2)))
        )

    for r in rings[:]:
        r["life"] -= dt
        r["radius"] += r["max"] * 2 * dt
        if r["life"] <= 0:
            rings.remove(r)
            continue
        pygame.draw.circle(
            screen, r["color"], ip(r["pos"]),
            int(r["radius"]), max(1, int(r["life"] * 6))
        )

    for m in messages[:]:
        if now >= m["until"]:
            messages.remove(m)

    for i, m in enumerate(messages[-3:]):
        draw_text(tr(m["key"]), font, m["color"], W // 2, 105 + i * 29)



        if keys[pygame.K_d]:
            p2["pos"].x += 235 * dt
        if now < p2["dash_until"]:
            p2["pos"].x += p2["dash_dir"] * 1000 * dt
        if keys[pygame.K_s]:
            activate_shield(p2, now)
        if keys[pygame.K_w] or (
            mode == "duel" and pygame.mouse.get_pressed()[0]
        ):
